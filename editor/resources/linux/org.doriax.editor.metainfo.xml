<component type="desktop-application">
  <id>org.doriax.editor</id>
  <launchable type="desktop-id">doriax-editor.desktop</launchable>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Doriax</name>
  <summary>Build cross-platform 2D and 3D games</summary>

  <developer id="org.doriax">
    <name>Eduardo Doria Lima</name>
  </developer>

  <description>
    <p>
      Doriax is a free, open-source 2D/3D game engine with an integrated editor
      for building cross-platform games and interactive projects with Lua or C++.
    </p>
    <p>
      Projects target Windows, Linux, macOS, Android, iOS and HTML5 from a single
      source, rendering through OpenGL, Vulkan, Metal or DirectX.
    </p>
  </description>

  <categories>
    <category>Development</category>
    <category>IDE</category>
  </categories>

  <keywords>
    <keyword>game</keyword>
    <keyword>engine</keyword>
    <keyword>3d</keyword>
    <keyword>2d</keyword>
    <keyword>editor</keyword>
  </keywords>

  <url type="homepage">https://doriax.org</url>
  <url type="help">https://docs.doriax.org</url>
  <url type="bugtracker">https://github.com/doriaxengine/doriax/issues</url>
  <url type="vcs-browser">https://github.com/doriaxengine/doriax</url>

  <screenshots>
    <screenshot type="default">
      <caption>Editing a 3D scene</caption>
      <image>https://www.doriax.org/screenshots/editor-3d-scene.png</image>
    </screenshot>
    <screenshot>
      <caption>Editing a 2D sprite scene</caption>
      <image>https://www.doriax.org/screenshots/editor-2d-sprite.png</image>
    </screenshot>
    <screenshot>
      <caption>Writing gameplay code in the built-in editor</caption>
      <image>https://www.doriax.org/screenshots/editor-code.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
